# Copy to `.env`. Real secrets must never be committed.

# --- PostgreSQL ---
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me
# Overridden to `postgresql` / `5432` inside docker compose. When running the backend on the host,
# use localhost and the published port of the postgresql container (5433).
DB_HOST=postgresql
DB_PORT=5432
LOCAL_DB_PORT=5433

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
LOCAL_REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=change-me

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_BUCKET_REGION_NAME=

# --- SMS (Brevo), used by phone OTP ---
BREVO_SMS_API_KEY=

# --- SMTP ---
EMAIL_HOSTNAME=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_FROM_EMAIL=
EMAIL_PASSWORD=

# --- Mailchimp ---
MAILCHIMP_API_KEY=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=

# --- JWT ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# Comma-separated exact origins, plus an optional regex (e.g. ".*" for local dev)
# CORS_ORIGINS=http://localhost:8081
# CORS_ORIGIN_REGEX=.*
